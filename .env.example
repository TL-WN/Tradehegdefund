# Copy this file to .env and fill in. All optional except LLM_API_KEY (only if
# you want the desk to consult an external model instead of the orchestrator).

# --- Optional: external LLM for the desk (OpenAI-compatible) ---
# Leave blank to have the host orchestrator (e.g. Hermes) play the personas.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Live execution (DO NOT ENABLE WITHOUT A BROKER + TESTING) ---
# Both must be set to 1 / YES, and execution.place_order() must be implemented.
EXEC_LIVE=0
EXEC_CONFIRMED=NO

# --- Firm timetable (24h local time) ---
MEETING_OPENING=08:00
MEETING_MIDDAY=13:00
MEETING_CLOSE=17:30

# --- Boss delivery ---
BOSS_CHANNEL=telegram
